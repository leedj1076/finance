# Local: direct URL (127.0.0.1:54322).
# Vercel runtime: Supabase transaction pooler URL (port 6543).
# Production migrations/admin scripts: override this with the direct URL or
# session pooler URL (port 5432) in the shell running the command.
DATABASE_URL=

# Safe to expose to the browser. Use the matching local or cloud project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local administration, data migration support, and tests only.
# Never expose this to browser code or configure it in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only AI classification fallback. Without it, imports still work
# and unknown merchants remain review items. Add this in Vercel Dashboard only
# when the production AI fallback should be enabled.
OPENAI_API_KEY=

# Monthly diagnosis uses the existing Codex CLI login, not OPENAI_API_KEY.
# Register the Mac with `pnpm diagnosis:setup --household <uuid>`.
# Its household-scoped token is stored in a private JSON file outside this repo.
# The long-running worker reads only that JSON, never this administrator env file.
