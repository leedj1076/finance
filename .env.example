# Local: direct URL (127.0.0.1:54322).
# Vercel runtime: Supabase transaction pooler URL (port 6543).
# Production migrations/admin scripts: override this with the direct URL or
# session pooler URL (port 5432) in the shell running the command.
DATABASE_URL=

# Safe to expose to the browser. Use the matching local or cloud project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local administration, data migration support, and tests only.
# Never expose this to browser code or configure it in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
