# App/runtime database connection. Use the local direct URL in development and
# Supabase's transaction pooler URL in Vercel.
DATABASE_URL=

# Safe to expose to the browser. Values come from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local administration and test scripts only. Never configure this in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
